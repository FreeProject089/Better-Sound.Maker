{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FreeProject089/Better-Sound.Maker/schemas/preset.schema.json",
  "title": "Better Sound.Maker preset",
  "type": "object",
  "required": ["name", "assetPaths"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "description": "Display name; also the identity used to detect updates." },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "version": { "type": "string", "pattern": "^\d+(\.\d+){0,2}$" },
    "UpdateNumber": { "type": "integer", "minimum": 1, "description": "Increase on every published change; higher wins." },
    "date": { "type": "string", "format": "date-time" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "assetPaths": {
      "type": "array",
      "items": { "type": "string", "description": "SDEF path relative to Sounds/sdef, forward slashes." },
      "uniqueItems": true
    },
    "customTypes": { "$ref": "sound-types.schema.json" }
  }
}
