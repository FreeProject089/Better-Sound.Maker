{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Sound.Maker",
  "version": "../package.json",
  "identifier": "com.bettersoundmaker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Better Sound.Maker",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0d1117",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../Update/": "Update/",
      "../LICENSE": "LICENSE",
      "../public/LICENSE": "public/LICENSE",
      "../public/presets/": "public/presets/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMTU2QUMzRUU2QTc4ODkKUldTSmVHcnV3Mm9Wcm1YcTFBUUliZzBlV0RQT2VnZTM5UkVCZVZraHNLQlVUYjJ5NGJJelhTNmMK",
      "endpoints": [
        "https://github.com/FreeProject089/Better-Sound.Maker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
